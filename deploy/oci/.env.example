# 复制到服务器 /opt/stack/aitoearn/.env（权限 600）后填写。不要提交真实值。
# 密码类用 `openssl rand -hex 24` 生成（只含 0-9a-f，放进连接串不用转义）

# 应用镜像版本：GitHub Actions「Fork Images」构建出来的标签，形如 20260917-1a2b3c4d
AITOEARN_TAG=

# 域名：主站（网页 + /api + /oss）和浏览器直传文件用的存储域名
DOMAIN=pub.flyooo.uk
OSS_DOMAIN=pub-oss.flyooo.uk

# 数据目录（数据盘）与本机端口（只绑 127.0.0.1，给 Cloudflare 隧道用）
DATA_DIR=/data/aitoearn
WEB_PORT=18180
OSS_PORT=19180

MONGO_PASSWORD=
REDIS_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# 登录凭证签名密钥：换了所有登录（包括插件）都要重新拿 token
JWT_SECRET=
# server 和 ai 两个服务之间互相调用的口令
INTERNAL_TOKEN=

# 发布渠道 Relay（借官方 aitoearn.ai 的平台授权）；留空则不启用
RELAY_API_KEY=
# AI：OpenAI 兼容上游；留空保留官方默认（官方地址，没 Key 调不通）
OPENAI_BASE_URL=
OPENAI_API_KEY=
# AI Relay（视频生成等转给官方）；留空不启用
AI_RELAY_API_KEY=

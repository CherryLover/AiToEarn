# 复制到服务器 /opt/stack/aitoearn/.env（权限 600）后填写。不要提交真实值。
# 密码类用 `openssl rand -hex 24` 生成（只含 0-9a-f，放进连接串不用转义）

# 应用镜像版本：GitHub Actions「Fork Images」构建出来的标签，形如 20260918-1a2b3c4d
# 三个服务分开记：只改后台时不会重新构建网页镜像，版本号不一定一致
# deploy.sh <标签> 会自动只更新该标签真实存在的那几个
SERVER_TAG=
AI_TAG=
WEB_TAG=

# 域名：主站（网页 + /api + /oss）和浏览器直传文件用的存储域名
DOMAIN=pub.flyooo.uk
OSS_DOMAIN=pub-oss.flyooo.uk

# 数据目录（数据盘）与本机端口（只绑 127.0.0.1，给本机检查用；对外走 Traefik）
DATA_DIR=/data/aitoearn
WEB_PORT=18180
OSS_PORT=19180

MONGO_PASSWORD=
REDIS_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# 登录凭证签名密钥：换了所有登录（包括插件）都要重新登录
JWT_SECRET=
# server 和 ai 两个服务之间互相调用的口令
INTERNAL_TOKEN=

# 发布渠道 Relay（借官方 aitoearn.ai 的平台授权）；留空则不启用
RELAY_API_KEY=
# AI：OpenAI 兼容上游，地址要带 /v1（如 https://way.flyooo.uk/v1）；留空保留官方默认（官方地址，没 Key 调不通）
OPENAI_BASE_URL=
OPENAI_API_KEY=
# AI Relay（视频生成等转给官方）；留空不启用
AI_RELAY_API_KEY=

# 登录：Pocket ID（OIDC）。客户端回调地址填 https://$DOMAIN/api/auth/oidc/callback
OIDC_ISSUER=https://id.flyooo.uk
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 允许登录的邮箱，逗号分隔；首次登录自动建号
OIDC_ALLOWED_EMAILS=jerry@flyooo.uk

# 推送：Bark（草稿生成完、有工单等你去发时，往手机推一条提醒）
# 四行都要留着：render_config.py 严格替换，缺变量渲染配置时直接报错
# 留空 = 静默关掉推送，服务一切照常，不报错也不刷日志
# 要真推：NOTIFY_ENABLED 填 true，地址和 key 去自建的 Bark 服务拿
# （地址形如 https://<Bark 域名>/<设备 key>/，NOTIFY_BARK_KEY 是请求头 bark-key 的值）
NOTIFY_ENABLED=
NOTIFY_BARK_URL=
NOTIFY_BARK_KEY=
NOTIFY_GROUP=AiToEarn

# 复制到服务器 /opt/stack/aitoearn/.env（权限 600）后填写。不要提交真实值。
# 密码类用 `openssl rand -hex 24` 生成（只含 0-9a-f，放进连接串不用转义）

# 应用镜像版本：GitHub Actions「Fork Images」构建出来的标签，形如 20260918-1a2b3c4d
# 三个服务分开记：只改后台时不会重新构建网页镜像，版本号不一定一致
# deploy.sh <标签> 会自动只更新该标签真实存在的那几个；
# 不带参数跑 deploy.sh 则是各自升到 main 上的最新构建，这里会被改写成具体版本号
SERVER_TAG=
AI_TAG=
WEB_TAG=

# 域名：主站（网页 + /api + /oss）和浏览器直传文件用的存储域名
DOMAIN=pub.flyooo.uk
OSS_DOMAIN=pub-oss.flyooo.uk

# 数据目录（数据盘）与本机端口（只绑 127.0.0.1，给本机检查用；对外走 Traefik）
DATA_DIR=/data/aitoearn
WEB_PORT=18180
OSS_PORT=19180

MONGO_PASSWORD=
REDIS_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# 登录凭证签名密钥：换了所有登录（包括插件）都要重新登录
JWT_SECRET=
# server 和 ai 两个服务之间互相调用的口令
INTERNAL_TOKEN=

# 发布渠道 Relay（借官方 aitoearn.ai 的平台授权）；留空则不启用
RELAY_API_KEY=
# AI：OpenAI 兼容上游，地址要带 /v1（如 https://way.flyooo.uk/v1）；留空保留官方默认（官方地址，没 Key 调不通）
OPENAI_BASE_URL=
OPENAI_API_KEY=
# AI Relay（视频生成等转给官方）；留空不启用
AI_RELAY_API_KEY=

# Agent：网页上「让 AI 提炼方向」「生成草稿」跑的是 Claude Code，走的是这组配置，
# 和上面 OPENAI_* 那组对话模型完全是两条线，只配 OPENAI_* 这条链路一样是坏的。
# 上游两种协议都能接，靠 AGENT_TRANSFORMERS 区分（claude-code-router 负责转换）：
#   OpenAI 协议（和 OPENAI_BASE_URL 同一个中转站就属于这种）
#     AGENT_BASE_URL 写到 /v1/chat/completions 这一层，AGENT_TRANSFORMERS 填 none
#   Anthropic 协议（官方，或上游自己暴露的 anthropic 端点）
#     AGENT_BASE_URL 写到 /v1/messages 这一层，AGENT_TRANSFORMERS 留空（等于默认的 Anthropic 透传）
# 七行都要留着：render_config.py 严格替换，缺变量渲染配置时直接报错。
# 留空 = 保留仓库里的占位值（api.openai.com + sk-placeholder），一提炼就报
# 「There's an issue with the selected model」。
AGENT_BASE_URL=
AGENT_API_KEY=
# 可用模型清单，逗号分隔，上游放行什么就写什么
AGENT_MODELS=
# 三个角色模型，留空就用清单第一个；填了必须在清单里，否则渲染阶段直接报错
AGENT_DEFAULT_MODEL=
AGENT_BACKGROUND_MODEL=
AGENT_THINK_MODEL=
# 跟上游说话的方式：none = 不加 transformer，由 router 做 Anthropic↔OpenAI 互转（上游是 OpenAI 协议时填这个）
# 留空 = 用默认的 Anthropic 透传（上游本身就说 Anthropic 协议时）
# 也可以逗号分隔指定 router 支持的其它 transformer，如 openrouter、deepseek
AGENT_TRANSFORMERS=

# 登录：Pocket ID（OIDC）。客户端回调地址填 https://$DOMAIN/api/auth/oidc/callback
OIDC_ISSUER=https://id.flyooo.uk
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 允许登录的邮箱，逗号分隔；首次登录自动建号
OIDC_ALLOWED_EMAILS=jerry@flyooo.uk

# 推送：Bark（草稿生成完、有工单等你去发时，往手机推一条提醒）
# 四行都要留着：render_config.py 严格替换，缺变量渲染配置时直接报错
# 留空 = 静默关掉推送，服务一切照常，不报错也不刷日志
# 要真推：NOTIFY_ENABLED 填 true，地址和 key 去自建的 Bark 服务拿
# （地址形如 https://<Bark 域名>/<设备 key>/，NOTIFY_BARK_KEY 是请求头 bark-key 的值）
NOTIFY_ENABLED=
NOTIFY_BARK_URL=
NOTIFY_BARK_KEY=
NOTIFY_GROUP=AiToEarn
